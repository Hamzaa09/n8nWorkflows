      "parameters": {
        "promptType": "define",
        "text": "=Act as a YouTube Viral Growth Expert. \n\nI am providing a visual description of a video. Create ONE high-CTR (Click-Through Rate) YouTube title that is under 65 characters. \n\nRequirements:\n- Include 1 or 2 relevant emojis at the end of the title.\n- Do NOT use quotes.\n- Do NOT provide explanations or multiple options.\n- Focus on the \"wow factor\" of the visuals.\n- Use title case.\n\nInput Description:\n{{ $('Basic LLM Chain').item.json.text }}",
        "batching": {}
